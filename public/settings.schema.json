{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.buildy.tw/settings.schema.json",
  "title": "Codex v0.4 site settings (one record per site and locale)",
  "description": "Codex v0.4.0 core (draft, docs/core-draft.md in github.com/ui8kit/contract). Structural check only; uniqueness of (id, locale) and slugs is checked by the @ui8kit/contract validator.",
  "x-codex-version": "0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "locale",
    "title",
    "language",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 tag, e.g. ru, en-US. The record key is (id, locale)."
    },
    "origin": {
      "description": "Where the record came from (migrations). Platform ids are strings here.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "id"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "metadata": {
      "description": "Typed values: numbers stay numbers, booleans stay booleans.",
      "type": "object",
      "propertyNames": {
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {},
          "private": {
            "type": "boolean"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 tag, e.g. ru, en-US. The record key is (id, locale)."
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone, e.g. Europe/Moscow"
    },
    "logo_media_id": {
      "type": "string"
    },
    "icon_media_id": {
      "type": "string"
    },
    "front_page_id": {
      "type": "string",
      "description": "Entry shown on the front page; absent = latest posts"
    },
    "posts_page_id": {
      "type": "string"
    },
    "posts_per_page": {
      "type": "integer",
      "minimum": 1
    },
    "comments_open": {
      "type": "boolean",
      "description": "Default for new entries"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217; default currency of money fields (integer minor units)"
    }
  }
}

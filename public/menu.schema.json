{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.buildy.tw/menu.schema.json",
  "title": "Codex v0.4 Menu (labels are plain strings; translations live in dictionaries)",
  "description": "Codex v0.4.0 core (draft, docs/core-draft.md in github.com/ui8kit/contract). Structural check only; uniqueness of (id, locale) and slugs is checked by the @ui8kit/contract validator.",
  "x-codex-version": "0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "location",
    "locale",
    "items"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 tag, e.g. ru, en-US. The record key is (id, locale)."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "parent_id": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  }
}

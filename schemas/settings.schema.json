{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.buildy.tw/settings.schema.json",
  "title": "Codex v0.4 site settings (one record per site and locale)",
  "description": "Codex v0.4.0 core (draft, docs/core-draft.md in github.com/ui8kit/contract). Structural check only; uniqueness of (id, locale) and slugs is checked by the @ui8kit/contract validator.",
  "x-codex-version": "0.4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "locale",
    "title",
    "language",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 tag, e.g. ru, en-US. The record key is (id, locale)."
    },
    "origin": {
      "description": "Where the record came from (migrations). Platform ids are strings here.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "id"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "metadata": {
      "description": "Typed values: numbers stay numbers, booleans stay booleans.",
      "type": "object",
      "propertyNames": {
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value"
        ],
        "properties": {
          "value": {},
          "private": {
            "type": "boolean"
          }
        }
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 tag, e.g. ru, en-US. The record key is (id, locale)."
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone, e.g. Europe/Moscow"
    },
    "logo_media_id": {
      "type": "string"
    },
    "icon_media_id": {
      "type": "string"
    },
    "front_page_id": {
      "type": "string",
      "description": "Entry shown on the front page; absent = latest posts"
    },
    "posts_page_id": {
      "type": "string"
    },
    "posts_per_page": {
      "type": "integer",
      "minimum": 1
    },
    "comments_open": {
      "type": "boolean",
      "description": "Default for new entries"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217; default currency of money fields (integer minor units)"
    },
    "contact": {
      "description": "Contact data. address is localized (one per settings record / locale); the other fields are the same in every locale.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{1,14}$",
          "description": "E.164, e.g. +12025550143"
        },
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "x-ui-hint": "email",
          "description": "A string with UI hint email (not a separate type)"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Postal address in the record's locale"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "network",
              "handle"
            ],
            "properties": {
              "network": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              },
              "handle": {
                "type": "string",
                "pattern": "^\\S+$",
                "description": "Network id without spaces: Telegram username without @, WhatsApp number in E.164, profile name"
              }
            }
          },
          "description": "Messengers and social profiles; source order kept, never sorted"
        }
      }
    },
    "hours": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "days",
          "open",
          "close"
        ],
        "properties": {
          "days": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri",
                "sat",
                "sun"
              ]
            }
          },
          "open": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "HH:MM, 00:00 to 23:59"
          },
          "close": {
            "type": "string",
            "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$",
            "description": "HH:MM, 00:00 to 24:00; earlier than open = past midnight; never equal to open"
          }
        }
      },
      "description": "Weekly opening hours in timezone; days not named are closed; source order kept"
    },
    "hours_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "YYYY-MM-DD in settings.timezone"
          },
          "closed": {
            "const": true
          },
          "open": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "HH:MM"
          },
          "close": {
            "type": "string",
            "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$",
            "description": "HH:MM, up to 24:00"
          }
        },
        "minProperties": 2,
        "dependentRequired": {
          "open": [
            "close"
          ],
          "close": [
            "open"
          ]
        },
        "dependentSchemas": {
          "closed": {
            "properties": {
              "open": false,
              "close": false
            }
          }
        }
      },
      "description": "Dates replacing the weekly hours: {date, closed: true} or {date, open, close}; one per date"
    },
    "map": {
      "description": "Map pin: provider and/or WGS 84 coordinates (lat and lng together)",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "dependentRequired": {
        "lat": [
          "lng"
        ],
        "lng": [
          "lat"
        ]
      }
    }
  }
}

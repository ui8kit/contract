{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.ui8kit.com/v0.3/taxonomy.schema.json",
  "title": "Codex taxonomy bundle (taxonomy.Definition + []taxonomy.Term)",
  "description": "Codex v0.3.0 wire contract (github.com/fastygo/codex). Structural check only; semantic rules (cross-references, field placement, timestamps order) are in the @ui8kit/contract validator.",
  "x-codex-version": "0.3.0",
  "$ref": "#/$defs/TaxonomyBundle",
  "$defs": {
    "LocalizedText": {
      "description": "Locale -> text. Locale keys must be canonical (lower-case, trimmed); `und` is the neutral locale.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "TaxonomyBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "terms"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/Definition"
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          }
        }
      }
    },
    "Definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "mode",
        "assigned_to_kinds",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "label": {
          "$ref": "#/$defs/LocalizedText"
        },
        "mode": {
          "enum": [
            "flat",
            "hierarchical"
          ]
        },
        "assigned_to_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          }
        },
        "public": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "taxonomy_id",
        "name",
        "slug",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "taxonomy_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "name": {
          "$ref": "#/$defs/LocalizedText"
        },
        "slug": {
          "$ref": "#/$defs/LocalizedText"
        },
        "description": {
          "$ref": "#/$defs/LocalizedText"
        },
        "parent_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "Assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_kind",
        "resource_id",
        "taxonomy_id",
        "term_id"
      ],
      "properties": {
        "resource_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "taxonomy_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "term_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
